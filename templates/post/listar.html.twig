{% extends '_layout.html.twig' %}

{% block title %}Posts{% endblock %}

{% block conteudo %}
<div class="cabecalho-pagina">
    <div>
        <h1>Posts</h1>
        <p class="texto-suave">
            {{ total }} post(s) no total · {{ totalPublicados }} publicado(s) · {{ total - totalPublicados }} rascunho(s)
        </p>
    </div>
    <a href="{{ path('post_novo') }}" class="botao botao--primario">+ Novo post</a>
</div>

<form method="get" action="{{ path('post_listar') }}" class="filtros">
    <input type="search" name="q" value="{{ termo }}" placeholder="Buscar por título ou conteúdo..." class="campo">
    <select name="status" class="campo">
        <option value="">Todos os status</option>
        <option value="publicado" {{ status == 'publicado' ? 'selected' }}>Publicados</option>
        <option value="rascunho" {{ status == 'rascunho' ? 'selected' }}>Rascunhos</option>
    </select>
    <button type="submit" class="botao">Filtrar</button>
    {% if termo or status %}
        <a href="{{ path('post_listar') }}" class="botao botao--fantasma">Limpar</a>
    {% endif %}
</form>

{% if posts is empty %}
    <div class="vazio">
        <p class="vazio__icone">🗒️</p>
        {% if termo or status %}
            <p>Nenhum post encontrado com esses filtros.</p>
        {% else %}
            <p>Nenhum post cadastrado ainda.</p>
            <a href="{{ path('post_novo') }}" class="botao botao--primario">Cadastrar o primeiro post</a>
        {% endif %}
    </div>
{% else %}
    <div class="grade-posts">
        {% for post in posts %}
            <article class="cartao">
                <div class="cartao__topo">
                    <span class="selo {{ post.publicado ? 'selo--publicado' : 'selo--rascunho' }}">
                        {{ post.publicado ? 'Publicado' : 'Rascunho' }}
                    </span>
                    {% if post.categoria %}
                        <span class="categoria">{{ post.categoria }}</span>
                    {% endif %}
                </div>

                <h2 class="cartao__titulo">
                    <a href="{{ path('post_exibir', {id: post.id}) }}">{{ post.titulo }}</a>
                </h2>

                <p class="cartao__resumo">
                    {{ post.resumo ?: (post.conteudo|length > 140 ? post.conteudo|slice(0, 140) ~ '...' : post.conteudo) }}
                </p>

                <div class="cartao__rodape">
                    <span class="texto-suave">
                        {{ post.autor ? post.autor.nome : 'Sem autor' }} · {{ post.criadoEm|date('d/m/Y H:i') }}
                    </span>
                    <div class="acoes">
                        <a href="{{ path('post_exibir', {id: post.id}) }}" class="botao botao--pequeno">Ver</a>
                        <a href="{{ path('post_editar', {id: post.id}) }}" class="botao botao--pequeno">Editar</a>
                        {{ include('post/_form_excluir.html.twig', {pequeno: true}) }}
                    </div>
                </div>
            </article>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
